# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Arbiter (`arbiter-rs`) Parameterized 3/5/7-Node Heterogeneous Multi-OS Vagrant + Bento (`../bento`) Test Fleet
#
# Supports parameterized cluster sizes via `CLUSTER_SIZE` environment variable:
# - `CLUSTER_SIZE=3`: Nodes 1..=3 (`192.168.56.101` .. `192.168.56.103`), quorum majority = 2, fault tolerance f = 1
# - `CLUSTER_SIZE=5`: Nodes 1..=5 (`192.168.56.101` .. `192.168.56.105`), quorum majority = 3, fault tolerance f = 2
# - `CLUSTER_SIZE=7`: Nodes 1..=7 (`192.168.56.101` .. `192.168.56.107`), quorum majority = 4, fault tolerance f = 3

VAGRANTFILE_API_VERSION = "2"

BENTO_ROOT = File.expand_path("../../../bento", __dir__)
CLUSTER_SIZE = Integer(ENV.fetch("CLUSTER_SIZE", "7"))

unless [3, 5, 7].include?(CLUSTER_SIZE)
  raise "CLUSTER_SIZE must be 3, 5, or 7 (got #{CLUSTER_SIZE})"
end

FLEET_NODES = [
  {
    name: "arbiter-omnios",
    box: ENV.fetch("BENTO_OMNIOS_BOX", "bento/omnios-r151046"),
    ip: "192.168.56.101",
    os_family: "illumos",
    role: "master+agent",
    raft_id: 1,
    cpus: 2,
    memory: 2048
  },
  {
    name: "arbiter-freebsd",
    box: ENV.fetch("BENTO_FREEBSD_BOX", "bento/freebsd-14.0"),
    ip: "192.168.56.102",
    os_family: "freebsd",
    role: "master+agent",
    raft_id: 2,
    cpus: 2,
    memory: 2048
  },
  {
    name: "arbiter-rocky",
    box: ENV.fetch("BENTO_ROCKY_BOX", "bento/rockylinux-9"),
    ip: "192.168.56.103",
    os_family: "rocky",
    role: "master+agent",
    raft_id: 3,
    cpus: 2,
    memory: 2048
  },
  {
    name: "arbiter-debian",
    box: ENV.fetch("BENTO_DEBIAN_BOX", "bento/debian-12"),
    ip: "192.168.56.104",
    os_family: "debian",
    role: "agent",
    raft_id: 0,
    cpus: 2,
    memory: 2048
  },
  {
    name: "arbiter-alpine",
    box: ENV.fetch("BENTO_ALPINE_BOX", "bento/alpine-3.19"),
    ip: "192.168.56.105",
    os_family: "alpine",
    role: "agent",
    raft_id: 0,
    cpus: 2,
    memory: 1024
  },
  {
    name: "arbiter-windows",
    box: ENV.fetch("BENTO_WINDOWS_BOX", "bento/windows-2022"),
    ip: "192.168.56.106",
    os_family: "windows",
    role: "agent",
    raft_id: 0,
    cpus: 2,
    memory: 4096
  },
  {
    name: "arbiter-macos",
    box: ENV.fetch("BENTO_MACOS_BOX", "bento/macos-14"),
    ip: "192.168.56.107",
    os_family: "macos",
    role: "agent",
    raft_id: 0,
    cpus: 2,
    memory: 4096
  }
].freeze

ACTIVE_NODES = FLEET_NODES.first(CLUSTER_SIZE)

Vagrant.configure(VAGRANTFILE_API_VERSION) do |config|
  ACTIVE_NODES.each do |node|
    config.vm.define node[:name] do |vm_cfg|
      vm_cfg.vm.box = node[:box]
      vm_cfg.vm.hostname = node[:name]
      vm_cfg.vm.network "private_network", ip: node[:ip]

      vm_cfg.vm.synced_folder "../..", "/workspace/arbiter-rs", disabled: false

      if node[:os_family] == "windows"
        vm_cfg.vm.communicator = "winrm"
        vm_cfg.vm.provision "shell", inline: <<-POWERSHELL
          Write-Host "[arbiter-windows] Verifying MSVC/GNU compilation, Win32 GetLogicalProcessorInformationEx probe, and JobObject isolator (CLUSTER_SIZE=#{CLUSTER_SIZE})..."
          Set-Location C:\workspace\arbiter-rs
          cargo test --workspace --all-targets
        POWERSHELL
      else
        vm_cfg.vm.provision "shell", inline: <<-SHELL
          set -eu
          echo "[#{node[:name]}] Running OS-native probe, isolator, storage, and cluster verification for #{node[:os_family]} (role=#{node[:role]}, CLUSTER_SIZE=#{CLUSTER_SIZE})..."
          cd /workspace/arbiter-rs
          cargo test --workspace --all-targets
        SHELL
      end
    end
  end
end
